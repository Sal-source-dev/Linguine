    </div>
    {% if reglages.nom_explication %}
    <aside class="lateral" style="align-self:flex-start;margin-top:12px">
      <div class="carte-inverse"><p class="etiquette" style="margin-bottom:8px">Le nom</p><div class="prose">{{ reglages.nom_explication | md | safe }}</div></div>
    </aside>
    {% endif %}
  </div>
</div>

---
layout: layouts/base.njk
permalink: /
---
{%- set r = reglages -%}
{%- set mots = collections.mots | parDate -%}
{%- set mdm = collections.mots | trouverMot(r.mot_du_moment) or mots[0] -%}
{%- set articles = collections.articles | parDate -%}
<section class="hero conteneur">
  <div class="principal">
    <p class="etiquette">{{ r.surtitre | mdl | safe }}</p>
    <h1>{{ r.accroche | mdl | safe }}</h1>
    <div class="presentation">{{ r.presentation | md | safe }}</div>
  </div>
  {% if mdm %}
  <a class="carte-inverse mot-du-moment" href="{{ mdm.url }}">
    <p class="etiquette">Le mot du moment</p>
    <p class="grand">{{ mdm.data.mot }}</p>
    <p class="chaine">{{ mdm.data.parcours | chaine | safe }}</p>
    <p>{{ (mdm.data.accroche or mdm.data.resume) | mdl | safe }}</p>
  </a>
  {% endif %}
</section>

<section class="section conteneur" aria-labelledby="t-atlas">
  <a class="carte porte-atlas" href="/langues/">
    <div>
      <p class="etiquette">{{ collections.langues.length | pluriel("langue", "langues") }} · arbre, carte, frise</p>
      <h2 id="t-atlas">Atlas des langues</h2>
      <p>Toutes les langues du carnet, reliées par leur parenté, leur géographie et leur histoire. Chacune a sa fiche, ses notes et ses mots.</p>
      <span class="lien">Explorer le ciel →</span>
    </div>
    {{ collections.langues | miniCiel | safe }}
  </a>
</section>

<section class="section conteneur" aria-labelledby="t-tiroirs">
  <h2 id="t-tiroirs" style="margin-bottom:20px">Trois carnets</h2>
  <div class="grille tiroirs">
    <a class="carte" href="/mots/"><span class="nom">Mots voyageurs</span><span class="desc">L'histoire des mots empruntés : d'où ils viennent, par où ils sont passés, ce qu'ils ont changé en route.</span><span class="compte">{{ collections.mots.length | pluriel("fiche", "fiches") }}</span></a>
    <a class="carte" href="/lectures/"><span class="nom">Carnet de lectures</span><span class="desc">Des notes prises sur le vif : ce que je retiens, ce qui me résiste, les mots que j'ai envie de suivre.</span><span class="compte">{{ collections.lectures.length | pluriel("note", "notes") }}</span></a>
    <a class="carte" href="/articles/"><span class="nom">Articles</span><span class="desc">Des textes plus construits quand une thématique m'accroche : contact des langues, variation, phonétique…</span><span class="compte">{{ collections.articles.length | pluriel("article", "articles") }}</span></a>
  </div>
</section>

<section class="section conteneur" aria-labelledby="t-mots">
  <div class="section-tete"><h2 id="t-mots">Derniers mots voyageurs</h2><a href="/mots/">Tout le lexique</a></div>
  {% if mots.length %}
  <ul class="liste-mots">
    {% for m in mots | premiers(5) %}
    <li><a href="{{ m.url }}"><span class="lm-mot">{{ m.data.mot }}</span><span class="lm-langue">{{ m.data.langue }} → {{ m.data | arrivee }}</span><span class="lm-resume">{{ (m.data.accroche or m.data.resume) | mdl | safe }}</span></a></li>
    {% endfor %}
  </ul>
  {% else %}<p class="vide">Aucune fiche pour l'instant.</p>{% endif %}
</section>

<section class="section conteneur" aria-labelledby="t-articles">
  <div class="section-tete"><h2 id="t-articles">Derniers articles</h2><a href="/articles/">Tous les articles</a></div>
  {% if articles.length %}
  <div class="grille">
    {% for a in articles | premiers(2) %}{% include "carte-article.njk" %}{% endfor %}
  </div>
  {% else %}<p class="vide">Aucun article pour l'instant.</p>{% endif %}
</section>
